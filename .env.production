# --- SYSTEM CONFIG ---
ENV=production
SECRET_KEY=измени_меня_на_длинную_случайную_строку

# --- POSTGRESQL (PRODUCTION) ---
POSTGRES_DB=prod_db_name
POSTGRES_USER=prod_db_user
# Используйте сложный пароль (минимум 16 знаков, без спецсимволов, ломающих строки подключения)
POSTGRES_PASSWORD=надежный_пароль_генерации_uuid
POSTGRES_HOST=postgres_prod # или IP внешнего сервера БД
POSTGRES_PORT=5432

# --- RABBITMQ (PRODUCTION) ---
RABBITMQ_DEFAULT_USER=prod_rabbit_user
RABBITMQ_DEFAULT_PASS=надежный_пароль_rabbit
RABBITMQ_HOST=rabbitmq_prod
RABBITMQ_PORT=5672

# --- SMTP (PRODUCTION) ---
# На продакшене Mailpit отключаем, переходим на реальный шлюз (SendGrid, Postmark, Yandex/Mail 360)
SMTP_HOST=://your-provider.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=пароль_приложения_или_токен
